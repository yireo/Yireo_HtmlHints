{
    "name": "yireo/magento2-html-hints",
    "description": "Add HTML comment hints with block and container details to the Magento 2 frontend in developer mode",
    "type": "magento2-module",
    "require": {
        "ext-pcre": "*",
        "magento/framework": "^101.0 | ^102.0 | ^103.0",
        "magento/module-backend": "^101.0 | ^102.0",
        "magento/module-config": "^101.0 | ^102.0",
        "magento/module-page-cache": "^100.4",
        "magento/module-store": "^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\HtmlHints\\": ""
        }
    }
}